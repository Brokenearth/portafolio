---
import type { UniSportCaseStudy } from '../data/types';
import { UniSportArchitectureInspector } from './interactive/UniSportArchitectureInspector';

interface Props {
  sectionTitle: string;
  caseStudy: UniSportCaseStudy;
}

const { sectionTitle, caseStudy } = Astro.props;
---

<section id="unisport" class="border-b border-[var(--border)] py-14 sm:py-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <p class="font-mono text-xs font-semibold text-[var(--accent)]">{sectionTitle}</p>
      <span class="rounded-md border border-[var(--border)] bg-[var(--surface)] px-2.5 py-1 font-mono text-xs text-[var(--muted)]">
        {caseStudy.contextTag}
      </span>
    </div>

    <div class="mt-3 flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
      <div class="max-w-3xl">
        <h2 class="font-display text-2xl font-bold text-[var(--text)] sm:text-3xl">
          {caseStudy.title}
        </h2>
        <p class="mt-2.5 max-w-[68ch] text-base text-[var(--muted)]">
          {caseStudy.subtitle}
        </p>
      </div>

      <div class="shrink-0">
        <a
          href={caseStudy.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-md bg-[var(--accent)] px-4 py-2.5 text-sm font-medium text-[var(--on-accent)] transition-colors hover:bg-[var(--accent-hover)]"
        >
          <span>{caseStudy.liveLabel}</span>
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <polyline points="15 3 21 3 21 9" />
            <line x1="10" x2="21" y1="14" y2="3" />
          </svg>
        </a>
      </div>
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-12">
      <div class="spotlight-card rounded-[10px] border border-[var(--border)] bg-[var(--surface)] p-5 lg:col-span-7">
        <p class="max-w-[68ch] text-sm leading-relaxed text-[var(--text)]">
          {caseStudy.overview}
        </p>
        <h3 class="mt-5 font-display text-sm font-semibold text-[var(--text)]">
          {caseStudy.myContributionsTitle}
        </h3>
        <ul class="mt-3 space-y-2.5">
          {caseStudy.myContributions.map((item) => (
            <li class="flex items-start gap-2.5 text-sm text-[var(--text)]">
              <svg
                class="mt-0.5 h-4 w-4 shrink-0 text-[var(--verified)]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="20 6 9 17 4 12" />
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <p class="mt-5 rounded-md border border-[var(--border)] bg-[var(--surface-muted)] px-3.5 py-2.5 text-xs text-[var(--muted)]">
          {caseStudy.privateRepoNote}
        </p>
      </div>

      <div class="spotlight-card flex flex-col justify-between rounded-[10px] border border-[var(--border)] bg-[var(--surface)] p-5 lg:col-span-5">
        <dl class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-1">
          {caseStudy.metrics.map((metric) => (
            <div class="flex items-baseline justify-between gap-3 border-b border-[var(--border)] pb-2.5 last:border-b-0 last:pb-0">
              <dt class="text-xs font-medium text-[var(--muted)]">{metric.label}</dt>
              <dd class="text-right font-mono text-xs font-semibold text-[var(--text)]">
                {metric.value}
              </dd>
            </div>
          ))}
        </dl>

        <div class="mt-5 flex flex-wrap gap-1.5 border-t border-[var(--border)] pt-4">
          {caseStudy.stack.map((tech) => (
            <span class="rounded-md border border-[var(--border)] bg-[var(--bg)] px-2.5 py-1 font-mono text-xs text-[var(--text)]">
              {tech}
            </span>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-6">
      <UniSportArchitectureInspector client:visible caseStudy={caseStudy} />
    </div>
  </div>
</section>
