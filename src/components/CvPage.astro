---
import type { Locale } from '../data/types';
import { getPortfolioData } from '../data/portfolio';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const data = getPortfolioData(locale);
const homeHref = locale === 'en' ? '/en/' : '/';
---

<BaseLayout
  locale={data.locale}
  title={data.cv.pageTitle}
  description={data.meta.description}
  skipLabel={data.nav.skipToContent}
>
  <SiteHeader
    locale={data.locale}
    shortName={data.profile.shortName}
    nav={data.nav}
    isCvPage={true}
  />

  <main id="main-content" class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="no-print mb-6 flex flex-wrap items-center justify-between gap-3">
      <a
        href={homeHref}
        class="inline-flex items-center rounded-md border border-[var(--border)] bg-[var(--surface)] px-3.5 py-2 text-sm font-medium text-[var(--text)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
      >
        {data.cv.backLabel}
      </a>
      <button
        type="button"
        onclick="window.print()"
        class="inline-flex cursor-pointer items-center gap-2 rounded-md bg-[var(--accent)] px-4 py-2 text-sm font-medium text-[var(--on-accent)] transition-colors hover:bg-[var(--accent-hover)]"
      >
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="6 9 6 2 18 2 18 9" />
          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
          <rect width="12" height="8" x="6" y="14" />
        </svg>
        <span>{data.cv.printLabel}</span>
      </button>
    </div>

    <article class="print-sheet rounded-[10px] border border-[var(--border)] bg-[var(--surface)] p-6 sm:p-10">
      <header class="border-b border-[var(--border)] pb-6">
        <h1 class="font-display text-2xl font-bold text-[var(--text)] sm:text-3xl">
          {data.profile.name}
        </h1>
        <p class="mt-1 text-base font-medium text-[var(--accent)]">{data.profile.role}</p>
        <p class="mt-2 font-mono text-xs text-[var(--muted)]">
          {data.profile.email} ·{' '}
          <a href={data.profile.portfolioUrl} class="underline decoration-[var(--border)] underline-offset-2 hover:text-[var(--accent)]">
            {data.profile.portfolioHandle}
          </a>{' '}
          · {data.profile.githubHandle} · {data.profile.linkedinHandle} · {data.profile.location}
        </p>
        <p class="mt-4 max-w-[70ch] text-sm leading-relaxed text-[var(--text)]">
          {data.profile.summary}
        </p>
      </header>

      <section class="border-b border-[var(--border)] py-6">
        <h2 class="font-display text-base font-bold text-[var(--text)]">
          {data.cv.experienceTitle}
        </h2>
        <div class="mt-4 space-y-5">
          {data.cv.experience.map((item) => (
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="font-display text-sm font-semibold text-[var(--text)]">
                  {item.project}
                </h3>
                <span class="font-mono text-xs text-[var(--muted)]">{item.period}</span>
              </div>
              <p class="text-xs font-medium text-[var(--accent)]">{item.role}</p>
              <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-[var(--text)]">
                {item.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section class="border-b border-[var(--border)] py-6">
        <h2 class="font-display text-base font-bold text-[var(--text)]">
          {data.cv.educationTitle}
        </h2>
        <div class="mt-3">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="font-display text-sm font-semibold text-[var(--text)]">
              {data.cv.education.degree}
            </h3>
            <span class="font-mono text-xs text-[var(--muted)]">
              {data.cv.education.institution}
            </span>
          </div>
          <p class="mt-1 text-xs font-medium text-[var(--accent)]">{data.cv.education.status}</p>
          <p class="mt-1.5 text-sm text-[var(--muted)]">{data.cv.education.focus}</p>
        </div>
      </section>

      <section class="border-b border-[var(--border)] py-6">
        <h2 class="font-display text-base font-bold text-[var(--text)]">
          {data.cv.skillsTitle}
        </h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {data.cv.skillGroups.map((group) => (
            <div>
              <h3 class="font-mono text-xs font-semibold text-[var(--muted)]">{group.category}</h3>
              <p class="mt-1 text-sm text-[var(--text)]">{group.items.join(' · ')}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="pt-6">
        <h2 class="font-display text-base font-bold text-[var(--text)]">
          {data.cv.languagesTitle}
        </h2>
        <p class="mt-2 text-sm text-[var(--text)]">{data.cv.languages.join(' · ')}</p>
      </section>
    </article>
  </main>
</BaseLayout>
