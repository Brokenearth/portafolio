---
import { splitEmail } from '../data/email';

interface Props {
  email: string;
}

const { email } = Astro.props;
const { user, domain } = splitEmail(email);
---

<span class="whitespace-nowrap" data-email-text data-u={user} data-d={domain}>{user}<span class="email-at" aria-hidden="true"></span>{domain}</span>

<style>
  .email-at::before {
    content: '@';
  }
</style>
