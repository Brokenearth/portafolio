---
import type { Locale, ProfileData } from '../data/types';
import { CopyEmailButton } from './interactive/CopyEmailButton';

interface Props {
  locale: Locale;
  profile: ProfileData;
}

const { locale, profile } = Astro.props;
const cvHref = locale === 'en' ? '/en/cv' : '/cv';
---

<section class="border-b border-[var(--border)] py-12 sm:py-16">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 sm:px-6 lg:grid-cols-12 lg:items-start">
    <div class="lg:col-span-7">
      <div class="inline-flex items-center gap-2 rounded-md border border-[var(--border)] bg-[var(--surface)] px-3 py-1 font-mono text-xs text-[var(--muted)]">
        <span class="h-2 w-2 rounded-full bg-[var(--verified)]" aria-hidden="true"></span>
        <span>{profile.status}</span>
      </div>

      <h1 class="mt-5 font-display text-3xl font-bold leading-[1.15] text-[var(--text)] sm:text-5xl">
        {profile.headline}
      </h1>

      <p class="mt-4 max-w-[62ch] text-base leading-relaxed text-[var(--muted)] sm:text-lg">
        {profile.summary}
      </p>

      <p class="mt-3 font-mono text-xs text-[var(--muted)]">
        {profile.role} · {profile.university}
      </p>

      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a
          href="#unisport"
          class="inline-flex items-center gap-2 rounded-md bg-[var(--accent)] px-4 py-2.5 text-sm font-medium text-[var(--on-accent)] transition-colors hover:bg-[var(--accent-hover)]"
        >
          <span>{profile.primaryCta}</span>
        </a>

        <a
          href={cvHref}
          class="inline-flex items-center gap-2 rounded-md border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm font-medium text-[var(--text)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
        >
          <span>{profile.cvCta}</span>
        </a>

        <CopyEmailButton
          client:load
          email={profile.email}
          label={profile.copyEmailLabel}
          copiedLabel={profile.copiedEmailLabel}
        />

        <a
          href={profile.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-md border border-[var(--border)] bg-[var(--surface)] px-3.5 py-2 text-sm font-medium text-[var(--text)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
        >
          <svg
            class="h-4 w-4 text-[var(--muted)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
            <path d="M9 18c-4.51 2-5-2-7-2" />
          </svg>
          <span>GitHub</span>
        </a>
      </div>
    </div>

    <aside
      aria-label={profile.metricsTitle}
      class="rounded-[10px] border border-[var(--border)] bg-[var(--surface)] p-5 lg:col-span-5"
    >
      <div class="border-b border-[var(--border)] pb-3">
        <h2 class="font-mono text-xs font-semibold text-[var(--muted)]">
          {profile.metricsTitle}
        </h2>
      </div>
      <dl class="divide-y divide-[var(--border)]">
        {profile.metrics.map((metric) => (
          <div class="py-3.5 first:pt-3 last:pb-1">
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-sm font-medium text-[var(--text)]">{metric.label}</dt>
              <dd class="font-mono text-lg font-semibold text-[var(--accent)]">{metric.value}</dd>
            </div>
            <p class="mt-1 text-xs text-[var(--muted)]">{metric.detail}</p>
          </div>
        ))}
      </dl>
    </aside>
  </div>
</section>
